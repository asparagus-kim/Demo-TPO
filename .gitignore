# ─────────────────────────────────────────────────────────── secrets
# .env 에는 실제 키가 들어간다. 절대 커밋하지 않는다.
.env
.env.*
!.env.example

# ─────────────────────────────────────────────── python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage

# ─────────────────────────────────────────────── node / frontend
# 소스(frontend/src 등)는 **추적한다**. 의존성과 빌드 산출물만 제외한다.
node_modules/
frontend/dist/
frontend/.vercel/
frontend/*.tsbuildinfo
*.tsbuildinfo

# ─────────────────────────────────────────────── 런타임 산출물
# app/utils/cache.py 는 메모리 캐시지만, 분석 응답 덤프가 여기 쌓인다.
cache/
*.log

# ─────────────────────────────────────────────── 에디터 · OS · 도구
.DS_Store
.idea/
.vscode/
.claude/
.playwright-mcp/
.dev-shots/

# ─────────────────────────────────────────────── 세션 스크래치
# 작업 중 생긴 캡처·메모. 저장소에 남길 이유가 없다.
image.png
*-compare.png
stream-*.png
