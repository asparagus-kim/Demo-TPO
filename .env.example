# ----- API KEYS (DO NOT COMMIT REAL VALUES) -----

# National Tax Service (국세청 사업자 상태조회) via data.go.kr / odcloud
DATA_GO_KR_API_KEY=your_nts_service_key_here

# Google Maps Platform — Places API (New) + Geocoding API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# KMA (기상청) — data.go.kr 초단기/단기예보 serviceKey (URL-encoded or raw)
KMA_API_KEY=your_kma_api_key_here

# Kakao Local — 업종·주소·좌표 및 주변 상권 조회
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# Bizno — 사업자번호로 상호명 조회
BIZNO_API_KEY=your_bizno_api_key_here

# Groq — OpenAI 호환 LLM
OPENAI_API_KEY=your_groq_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# ----- ENDPOINTS (defaults usable as-is) -----
NTS_API_URL=https://api.odcloud.kr/api/nts-businessman/v1/status
TEXT_SEARCH_URL=https://places.googleapis.com/v1/places:searchText
PLACE_DETAILS_URL=https://places.googleapis.com/v1/{place_resource}
GEOCODE_URL=https://maps.googleapis.com/maps/api/geocode/json
KMA_ULTRA_NCST_URL=http://apis.data.go.kr/1360000/VilageFcstInfoService_2.0/getUltraSrtNcst
BIZNO_API_URL=https://bizno.net/api/fapi

# ----- RUNTIME -----
# Set MOCK_MODE=1 to run the pipeline without calling external APIs.
# The backend will return a deterministic mock analysis response that still
# flows through the scoring pipeline. Useful for UI development.
MOCK_MODE=0

# Cap of review_count sent to the LLM for scoring. Keep modest for cost control.
LLM_REVIEW_CAP=25

# Logging
LOG_LEVEL=INFO
