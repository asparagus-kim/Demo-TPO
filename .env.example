# ----- API KEYS (DO NOT COMMIT REAL VALUES) -----

# National Tax Service (국세청 사업자 상태조회) via data.go.kr / odcloud
DATA_GO_KR_API_KEY=your_nts_service_key_here

# Google Maps Platform — Places API (New) + Geocoding API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# KMA (기상청) — data.go.kr 초단기/단기예보 serviceKey (URL-encoded or raw)
KMA_API_KEY=your_kma_api_key_here

# Kakao Local — 업종·주소·좌표 및 주변 상권 조회
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# Bizno — 사업자번호로 상호명 조회
BIZNO_API_KEY=your_bizno_api_key_here

# LLM — OpenAI 호환 엔드포인트면 무엇이든 된다. 아래 두 줄로 제공자가 갈린다.
#
#  Groq  ← 현재 사용 중
#    무료 등급 한도: 분당 8000토큰 / 하루 1000회  → 분석 약 200회/일
#
#  OpenRouter (대안 — 무료 모델은 `:free` 접미사)
#    OPENAI_BASE_URL=https://openrouter.ai/api/v1
#    OPENAI_MODEL=google/gemma-4-31b-it:free
#    무료 등급 한도: 분당 20회 / 하루 50회  → 분석 약 10회/일 (20배 적다)
#    크레딧 10달러 이상 구매 시 하루 1000회로 올라간다.
#
# 주의: `_call_openai` 는 response_format={"type":"json_object"} 를 쓴다.
# JSON 모드를 지원하지 않는 모델을 넣으면 매 호출이 실패하고 휴리스틱으로 떨어진다.
# (OpenRouter 무료 19개 중 JSON 모드 지원은 7개뿐 — 2026-09 확인)
OPENAI_API_KEY=your_groq_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=qwen/qwen3.8-27b

# OpenRouter 순위 페이지 노출용 선택 헤더 (없어도 호출은 된다)
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Yielda TPO

# ----- ENDPOINTS (defaults usable as-is) -----
NTS_API_URL=https://api.odcloud.kr/api/nts-businessman/v1/status
TEXT_SEARCH_URL=https://places.googleapis.com/v1/places:searchText
PLACE_DETAILS_URL=https://places.googleapis.com/v1/{place_resource}
GEOCODE_URL=https://maps.googleapis.com/maps/api/geocode/json
KMA_ULTRA_NCST_URL=http://apis.data.go.kr/1360000/VilageFcstInfoService_2.0/getUltraSrtNcst
BIZNO_API_URL=https://bizno.net/api/fapi

# ----- RUNTIME -----
# Set MOCK_MODE=1 to run the pipeline without calling external APIs.
# The backend will return a deterministic mock analysis response that still
# flows through the scoring pipeline. Useful for UI development.
MOCK_MODE=0

# LLM 묶음 크기 — 리뷰 N건을 요청 1번에 묶어 채점한다.
# Groq 무료 등급 병목은 OTPM(출력 토큰/분) 1000, 건당 ~83 tok. 6건 ≈ 500 tok.
LLM_REVIEW_CAP=6

# 웹검색 폴백(근거 검색 → 영업시간 재검색) 전체 벽시계 예산(초).
# 검색 엔진이 서버 IP 를 막으면 무제한일 때 60초 넘게 기다리고 결과는 0건이었다.
WEB_FALLBACK_BUDGET_SEC=4

# Logging
LOG_LEVEL=INFO

# ----- 분석 수집 (Analysis Data Collection) -----
# 분석 1건 = Google Sheet 1행. 설치 절차는 scripts/apps_script/README.md 참고.
# URL 자체가 자격증명이다 (아는 사람은 누구나 시트에 쓸 수 있다) — 프론트에 넣지 말 것.
# 비워 두면 수집 기능 전체가 조용히 꺼진다.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_TOKEN=
SHEETS_LOGGING_ENABLED=1
# 캐시 히트도 '분석을 돌린' 사건이므로 기본으로 기록한다 (cache_hit 열로 구분).
SHEETS_LOG_CACHE_HITS=1
# 매장 선택 등 중간 플로우 상태까지 기록할지. 켜면 분석 1건이 2행 이상이 된다.
SHEETS_LOG_NEEDS_INPUT=0
SHEETS_TIMEOUT_SEC=10
